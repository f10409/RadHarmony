        </mxCell>
        <mxCell id="zs_body" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e40af;fontSize=11;align=left;spacingLeft=8;" value="• per-label prompt ensembles&#xa;• encode_text → mean, L2-norm&#xa;• cosine(img, test_imgs) → score&#xa;• optional negative prompts&#xa;• full cls metric panel / label&#xa;• test set only, no folds" vertex="1">
          <mxGeometry height="220" width="220" x="620" y="640" as="geometry" />
        </mxCell>

