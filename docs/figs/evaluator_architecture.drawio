        <mxCell id="lp_body" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e40af;fontSize=11;align=left;spacingLeft=8;" value="• sklearn LogisticRegression&#xa;• KFold (n_folds=5) OR fixed split&#xa;• n_train sweep (1.5k…14k)&#xa;• optional stratified subsample&#xa;• full cls metric panel / label&#xa;• plot: metric vs n_train" vertex="1">
