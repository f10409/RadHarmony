          <mxGeometry height="35" width="220" x="380" y="600" as="geometry" />
        </mxCell>
        <mxCell id="knn_body" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e40af;fontSize=11;align=left;spacingLeft=8;" value="• L2-normalize feats&#xa;• KFold (n_folds=5) OR fixed split&#xa;• NearestNeighbors(k=20)&#xa;• cosine metric&#xa;• mean-vote per label&#xa;• full cls metric panel / label" vertex="1">
          <mxGeometry height="220" width="220" x="380" y="640" as="geometry" />
        </mxCell>

