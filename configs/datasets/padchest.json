  "registry_key": "padchest",
  "modality": "2D",
  "image_format": "PNG",

  "base_image_dir": "/path/to/PadChest/images/",

  "primary_csv": {
    "_comment": "Single CSV with one row per image. ImageID is the PNG filename; ImageDir (integer 0..50, 54) is the parent subdir under base_image_dir.",
    "path": "/path/to/PadChest/PADCHEST_chest_x_ray_images_labels_160K_01.02.19.csv.gz",
    "filename_variants": [
      "PADCHEST_chest_x_ray_images_labels_160K_01.02.19.csv.gz",
      "PADCHEST_chest_x_ray_images_labels_160K_01.02.19.csv"
