  "image_path": {
    "_comment": "Constructed as f'{ImageDir}/{ImageID}'. ImageDir is stored as int in the CSV, must be cast to str. Structural exception: 52 sibling image directories live INSIDE base_image_dir, so image_path carries the subdir name (same pattern as ChestX-ray14). Result resolves like 'images/0/<hash>_<slug>.png'.",
    "column": null,
    "derivation": "f'{ImageDir}/{ImageID}'",
    "prefix_to_strip": null
  },

