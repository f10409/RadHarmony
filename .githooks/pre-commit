#!/bin/sh
# Run the automatic checks on the staged files (no pytest).
# Turn on once per clone: git config core.hooksPath .githooks
TOP="$(git rev-parse --show-toplevel)"
PY="$TOP/.venv/bin/python"
[ -x "$PY" ] || PY=python3
# Import this checkout. In a worktree, the editable install points to the main folder.
export PYTHONPATH="$TOP${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" scripts/evalkit/run_all.py --fast
